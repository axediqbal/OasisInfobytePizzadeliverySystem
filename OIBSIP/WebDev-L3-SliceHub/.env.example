# ==========================================
# SliceHub Environment Configuration
# ==========================================

# Database Configuration
# Local: mongodb://127.0.0.1:27017/slicehub
# Production Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/slicehub?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/slicehub

# Server & JWT
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Email Dispatcher (Gmail SMTP or Test Mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Client URL
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@slicehub.test

